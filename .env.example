# Copy to .env only when changing defaults. Never commit real secrets.
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
NODE_ENV=development
DEMO_MODE=true
PAYMENT_MODE=demo
DATA_DIR=data

# Optional Razorpay test/live integration (change PAYMENT_MODE=razorpay).
# Use all TEST keys together for integration QA; never mix test and live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional real email delivery. Without this, messages stay in email_outbox.
RESEND_API_KEY=
EMAIL_FROM=
