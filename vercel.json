{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" },
    { "source": "/((?!api|uploads|assets|favicon|logo|app\\.js|app\\.css|.*\\..*).*)$", "destination": "/index.html" }
  ]
}
